{
  "suite": "puzzle",
  "protocolVersion": 1,
  "description": "Puzzle answer protocol. input.schema is PuzzleAnswerRequest, PuzzleAnswerResponse or SolveResponse; input.value is the JSON body; expected.valid says whether it parses. The challenge fields hold a syntactically valid opaque challenge (base64url).",
  "cases": [
    { "name": "request: minimal valid", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 0, "telemetry": "" } }, "expected": { "valid": true } },
    { "name": "request: answer 359 is the maximum", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 359, "telemetry": "dGVsZW1ldHJ5" } }, "expected": { "valid": true } },
    { "name": "request: answer 360 rejected", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 360, "telemetry": "" } }, "expected": { "valid": false } },
    { "name": "request: negative answer rejected", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": -1, "telemetry": "" } }, "expected": { "valid": false } },
    { "name": "request: fractional answer rejected", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 1.5, "telemetry": "" } }, "expected": { "valid": false } },
    { "name": "request: string answer rejected", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": "3", "telemetry": "" } }, "expected": { "valid": false } },
    { "name": "request: telemetry missing rejected", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 3 } }, "expected": { "valid": false } },
    { "name": "request: unknown field rejected", "input": { "schema": "PuzzleAnswerRequest", "value": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 3, "telemetry": "", "extra": 1 } }, "expected": { "valid": false } },
    { "name": "response: slider puzzle, second of two", "input": { "schema": "PuzzleAnswerResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["/v1/puzzle/asset/AQAAAAAAAAAAAAAAAAAA"], "range": { "min": 0, "max": 100, "step": 1 }, "attemptsLeft": 1, "step": 2, "steps": 2 } } }, "expected": { "valid": true } },
    { "name": "response: unknown kind is tolerated", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "future-kind", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["/v1/puzzle/asset/AQAAAAAAAAAAAAAAAAAA"], "attemptsLeft": 1 } } }, "expected": { "valid": true } },
    { "name": "response: odd-one-out with options", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "odd-one-out", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a", "b", "c", "d"], "options": 4, "attemptsLeft": 1 } } }, "expected": { "valid": true } },
    { "name": "response: rotate range to 359", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "rotate", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "range": { "min": 0, "max": 359, "step": 1 }, "attemptsLeft": 1 } } }, "expected": { "valid": true } },
    { "name": "response: zero assets rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": [], "attemptsLeft": 1 } } }, "expected": { "valid": false } },
    { "name": "response: ten assets rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "odd-one-out", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a","b","c","d","e","f","g","h","i","j"], "attemptsLeft": 1 } } }, "expected": { "valid": false } },
    { "name": "response: attemptsLeft 0 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 0 } } }, "expected": { "valid": false } },
    { "name": "response: attemptsLeft 2 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 2 } } }, "expected": { "valid": false } },
    { "name": "response: step 4 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1, "step": 4, "steps": 3 } } }, "expected": { "valid": false } },
    { "name": "response: audio group step 3 of 3", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1, "step": 3, "steps": 3 } } }, "expected": { "valid": true } },
    { "name": "response: steps 4 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1, "step": 1, "steps": 4 } } }, "expected": { "valid": false } },
    { "name": "response: step 0 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1, "step": 0, "steps": 2 } } }, "expected": { "valid": false } },
    { "name": "response: step and steps are optional", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1 } } }, "expected": { "valid": true } },
    { "name": "response: attemptsLeft 4 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 4 } } }, "expected": { "valid": false } },
    { "name": "response: options 1 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "audio", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "options": 1, "attemptsLeft": 1 } } }, "expected": { "valid": false } },
    { "name": "response: options 10 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "audio", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "options": 10, "attemptsLeft": 1 } } }, "expected": { "valid": false } },
    { "name": "response: range max 200 rejected", "input": { "schema": "SolveResponse", "value": { "type": "puzzle", "puzzle": { "kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "range": { "min": 0, "max": 200, "step": 1 }, "attemptsLeft": 1 } } }, "expected": { "valid": false } },
    { "name": "answer response: retry carries a fresh challenge", "input": { "schema": "PuzzleAnswerResponse", "value": { "type": "retry", "challenge": { "challenge": "AAAAAAAAAAAAAAAAAAAA", "pow": { "algorithm": "sha256-v1", "salt": "AAAAAAAAAAAAAAAAAAAAAA", "difficultyBits": 14, "count": 4 }, "signals": { "version": "1", "key": "AAAAAAAAAAAAAAAAAAAAAA" }, "expiresAt": 1893456000 } } }, "expected": { "valid": true } },
    { "name": "solve response: retry is not a solve type", "input": { "schema": "SolveResponse", "value": { "type": "retry", "challenge": {} } }, "expected": { "valid": false } },
    { "name": "answer response: token", "input": { "schema": "PuzzleAnswerResponse", "value": { "type": "token", "token": "abc", "expiresAt": 1893456000 } }, "expected": { "valid": true } },
    {"name": "request: telemetry of 8192 characters accepted", "input": {"schema": "PuzzleAnswerRequest", "value": {"challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 3, "telemetry": ""}}, "expected": {"valid": true}},
    {"name": "request: telemetry of 8193 characters rejected", "input": {"schema": "PuzzleAnswerRequest", "value": {"challenge": "AAAAAAAAAAAAAAAAAAAA", "answer": 3, "telemetry": ""}}, "expected": {"valid": false}},
    {"name": "request: empty challenge rejected", "input": {"schema": "PuzzleAnswerRequest", "value": {"challenge": "", "answer": 3, "telemetry": ""}}, "expected": {"valid": false}},
    {"name": "request: challenge of 4096 characters accepted", "input": {"schema": "PuzzleAnswerRequest", "value": {"challenge": "", "answer": 3, "telemetry": ""}}, "expected": {"valid": true}},
    {"name": "request: challenge of 4097 characters rejected", "input": {"schema": "PuzzleAnswerRequest", "value": {"challenge": "", "answer": 3, "telemetry": ""}}, "expected": {"valid": false}},
    {"name": "response: range min 1 rejected", "input": {"schema": "SolveResponse", "value": {"type": "puzzle", "puzzle": {"kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1, "range": {"min": 1, "max": 100, "step": 1}}}}, "expected": {"valid": false}},
    {"name": "response: range step 2 rejected", "input": {"schema": "SolveResponse", "value": {"type": "puzzle", "puzzle": {"kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1, "range": {"min": 0, "max": 100, "step": 2}}}}, "expected": {"valid": false}},
    {"name": "response: empty asset entry rejected", "input": {"schema": "SolveResponse", "value": {"type": "puzzle", "puzzle": {"kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": [""], "attemptsLeft": 1}}}, "expected": {"valid": false}},
    {"name": "response: unknown fields tolerated in puzzle, range and response", "input": {"schema": "SolveResponse", "value": {"type": "puzzle", "puzzle": {"kind": "slider", "challenge": "AAAAAAAAAAAAAAAAAAAA", "assets": ["a"], "attemptsLeft": 1, "range": {"min": 0, "max": 100, "step": 1, "future": 1}, "future": 2}, "future": 3}}, "expected": {"valid": true}},
    {"name": "answer response: unknown fields tolerated in retry", "input": {"schema": "PuzzleAnswerResponse", "value": {"type": "retry", "future": 1, "challenge": {"challenge": "AAAAAAAAAAAAAAAAAAAA", "pow": {"algorithm": "sha256-v1", "salt": "AAAAAAAAAAAAAAAAAAAAAA", "difficultyBits": 14, "count": 4}, "signals": {"version": "1", "key": "AAAAAAAAAAAAAAAAAAAAAA"}, "expiresAt": 1893456000}}}, "expected": {"valid": true}}
  ]
}
