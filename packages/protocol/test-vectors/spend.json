{
  "suite": "spend",
  "protocolVersion": 1,
  "description": "spendShardName known answers (protocol v1 section 9). The spend key is ASCII 'c:' (kind 'challenge') or 't:' (kind 'token') followed by the 16 bytes of idHex (the challenge id or the token_id); the name is spend:<siteId>:<shard>, where shard is the first 4 bytes of SHA-256(ASCII 'rg-spend-shard-v1' || u8 length of siteId || ASCII siteId || spend key), read as an unsigned 32-bit big-endian integer, modulo shards. A v1 server always uses shards = SPEND_SHARDS = 16; the cases with another shard count only check the modulo arithmetic. Inputs that must be rejected (any other spelling of the site UUID, another kind, an id that is not 16 bytes, a shard count outside 1..65536) are specified in v1.md section 9; each SDK tests them itself.",
  "cases": [
    { "name": "N = SPEND_SHARDS: challenge, ids 00..0f", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "challenge", "idHex": "000102030405060708090a0b0c0d0e0f", "shards": 16}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:14"} },
    { "name": "N = SPEND_SHARDS: token, same id as the challenge case, other name", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "token", "idHex": "000102030405060708090a0b0c0d0e0f", "shards": 16}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:7"} },
    { "name": "N = SPEND_SHARDS: challenge, nil site, zero id", "input": {"siteId": "00000000-0000-0000-0000-000000000000", "kind": "challenge", "idHex": "00000000000000000000000000000000", "shards": 16}, "expected": {"name": "spend:00000000-0000-0000-0000-000000000000:2"} },
    { "name": "N = SPEND_SHARDS: token, nil site, zero id", "input": {"siteId": "00000000-0000-0000-0000-000000000000", "kind": "token", "idHex": "00000000000000000000000000000000", "shards": 16}, "expected": {"name": "spend:00000000-0000-0000-0000-000000000000:10"} },
    { "name": "N = SPEND_SHARDS: challenge, nil site, all-ff id", "input": {"siteId": "00000000-0000-0000-0000-000000000000", "kind": "challenge", "idHex": "ffffffffffffffffffffffffffffffff", "shards": 16}, "expected": {"name": "spend:00000000-0000-0000-0000-000000000000:15"} },
    { "name": "N = SPEND_SHARDS: token, all-f site, all-ff id", "input": {"siteId": "ffffffff-ffff-ffff-ffff-ffffffffffff", "kind": "token", "idHex": "ffffffffffffffffffffffffffffffff", "shards": 16}, "expected": {"name": "spend:ffffffff-ffff-ffff-ffff-ffffffffffff:2"} },
    { "name": "N = SPEND_SHARDS: challenge, generated id 0", "input": {"siteId": "a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d", "kind": "challenge", "idHex": "a19b50039d18d52f880ac50bc84b5e0b", "shards": 16}, "expected": {"name": "spend:a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d:4"} },
    { "name": "N = SPEND_SHARDS: token, generated id 1", "input": {"siteId": "a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d", "kind": "token", "idHex": "29a1c3ef7aa6d3d55b0e3bc0798200dd", "shards": 16}, "expected": {"name": "spend:a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d:5"} },
    { "name": "N = SPEND_SHARDS: challenge, generated id 2", "input": {"siteId": "a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d", "kind": "challenge", "idHex": "34290b0f0455469a1101cc4bb7d04cb9", "shards": 16}, "expected": {"name": "spend:a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d:3"} },
    { "name": "N = SPEND_SHARDS: token, generated id 3", "input": {"siteId": "a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d", "kind": "token", "idHex": "582d3b781a11ef70ec91e2fa65974cac", "shards": 16}, "expected": {"name": "spend:a8b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d:13"} },
    { "name": "N = SPEND_SHARDS: token, generated id 4", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "token", "idHex": "5170c53e71cd1a7ceb266f2beef3089d", "shards": 16}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:3"} },
    { "name": "N = SPEND_SHARDS: challenge, generated id 5", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "challenge", "idHex": "3eb3fddcac2f9cd6ae33fa5b048fc14e", "shards": 16}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:12"} },
    { "name": "modulo check only (v1 uses 16): N = 1, challenge", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "challenge", "idHex": "000102030405060708090a0b0c0d0e0f", "shards": 1}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:0"} },
    { "name": "modulo check only (v1 uses 16): N = 7, token", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "token", "idHex": "000102030405060708090a0b0c0d0e0f", "shards": 7}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:5"} },
    { "name": "modulo check only (v1 uses 16): N = 65536, challenge", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "challenge", "idHex": "000102030405060708090a0b0c0d0e0f", "shards": 65536}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:58878"} },
    { "name": "modulo check only (v1 uses 16): N = 65536, token", "input": {"siteId": "3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b", "kind": "token", "idHex": "000102030405060708090a0b0c0d0e0f", "shards": 65536}, "expected": {"name": "spend:3f1c2a9e-5b7d-4e2f-9a1b-0c8d7e6f5a4b:39815"} }
  ]
}
