{
  "name": "@revokegpt/firewall-next",
  "version": "0.1.2",
  "description": "RevokeGPT firewall for Next.js: proxy.ts (Next 16) and a middleware.ts shim (Next 15), Node runtime.",
  "license": "MIT",
  "homepage": "https://revokegpt.com",
  "bugs": {
    "url": "https://github.com/ZaeemSattar/revokegpt-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZaeemSattar/revokegpt-js.git",
    "directory": "sdks/integrations/nextjs"
  },
  "keywords": [
    "revokegpt",
    "captcha",
    "recaptcha-alternative",
    "bot-protection",
    "proof-of-work",
    "nextjs",
    "middleware",
    "firewall"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "revokegpt": {
    "visibility": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@revokegpt/firewall": "0.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@revokegpt/protocol": "0.1.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "next": ">=15.5"
  }
}
